__pycache__/
*.pyc
.venv/

# Datos de prestadores: los formularios y resultados reales NUNCA van al repositorio (solo la demo sintética P2)
data/raw/*
data/logs/
data/.carga.lock
data/processed/*
!data/processed/p2/
# Formularios de PRUEBA (tools/generar_formularios_prueba.py): sintéticos, sirven para ensayar el pipeline en la demo
!data/raw/prueba/
# Entrega sintética de P2 (tools/generar_prestador_sintetico.py): permite reprocesar P2 desde la app
!data/raw/p2/
!data/processed/prueba/
# Salida del generador sintético sin --registrar (es la misma entrega que data/raw/p2/)
data/reference/sintetico/
